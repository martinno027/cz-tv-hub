; cz-tv-hub configuration (see spec/dvb-gateway.md). Keep this file 0600, owned by cztvhub.
[server]
host = 0.0.0.0          ; home LAN + Tailscale; never forward this port on the router
port = 8098

[dvb]
enabled = @DVB_ENABLED@
key = @KEY@             ; apps send "Authorization: Bearer <key>"
retention_days = 3      ; 1..14, default of "Uchovávat nahrávky" on /admin (the page's value wins)
record_channels = all   ; only for TVHeadend's own DVR (dvb-setup); the continuous recording is chosen on /admin
hls_dir = /var/lib/cztvhub/hls
; continuous recording of the channels with "Nahrávat" on /admin; on the recordings disk, e.g. /srv/tv/buffer
buffer_dir = /var/lib/cztvhub/buffer
max_recordings = 0      ; optional cap on channels recorded at once (0 = none); each costs ~20 % of a Pi 4 core
idle_seconds = 30

[ads]
; "Přeskočit reklamu" for antenna recordings (spec/ad-breaks.md). Off by default. The detection worker
; runs only on a household machine (home LAN or own tailnet), never in a cloud.
enabled = false
channels = all          ; or comma-separated TVHeadend channel names, e.g. Nova HD, Prima HD
worker_key =            ; random 32+ chars, different from [dvb] key
worker_hosts =          ; optional: source IPs allowed to use worker_key
breaks_dir = /var/lib/cztvhub/breaks

[admin]
; Web administration http://<raspberry>:8098/admin (user "admin"): which antenna channels the apps offer,
; record and receive. Empty = off. Needs [dvb] enabled; 12+ chars.
password = @ADMIN_PASSWORD@

[tmdb]
; Podrobnosti pořadů v aplikacích (rok, plakát, hodnocení TMDB). Vlastní bezplatný klíč: účet na themoviedb.org,
; Nastavení → API (nekomerční použití); "API Key" i "API Read Access Token" fungují. Prázdné = vypnuto.
; Programme details in the apps (year, poster, TMDB rating): your own free key from themoviedb.org, Settings → API.
; Empty = off; removing the key deletes the cached details.
key =

[tvheadend]
url = http://127.0.0.1:9981
user = cztvhub
password = @TVH_PASSWORD@
