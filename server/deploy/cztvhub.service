[Unit]
Description=cz-tv-hub (Ceska televize playlist/redirect service, DVB-T2 gateway)
After=network-online.target tvheadend.service
Wants=network-online.target
# The recordings disk (/srv/tv, fstab "nofail") is mounted before the start when it is there (only After=, no
# Requires=: a missing disk must not stop the CT streams); the gateway also reads the index again if it comes later.
After=srv-tv.mount

[Service]
User=cztvhub
Environment=PYTHONPATH=/opt/cztvhub/src
# Log lines reach the journal at once (block-buffered stdout held them back: one line in two days, 2026-10-31)
Environment=PYTHONUNBUFFERED=1
# DVB stays off unless enabled in the config; without [dvb] enabled = true this is the CT-only server.
ExecStart=/usr/bin/python3 -m cztvhub serve --config /etc/cztvhub/cztvhub.conf
Restart=always
RestartSec=3
# Temporary HLS (hls_dir); if you move hls_dir to the recordings disk, add that path here.
StateDirectory=cztvhub
ReadWritePaths=/var/lib/cztvhub
# Continuous recording on the recordings disk ([dvb] buffer_dir, see docs/dvb-setup.md); '-' = may not exist
ReadWritePaths=-/srv/tv
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
KillMode=control-group

[Install]
WantedBy=multi-user.target
